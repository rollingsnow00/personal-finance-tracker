{
  "info": {
    "name": "Personal Finance Tracker API",
    "description": "Lab 1 REST basics and end-to-end API flow for authentication, categories, transactions, budgets, reports, pagination, filtering, soft delete, and ADMIN restore.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
    "const now = new Date();",
    "pm.environment.set('today', now.toISOString().slice(0, 10));",
    "pm.environment.set('currentMonth', now.toISOString().slice(0, 7));",
    "if (pm.info.requestName === 'Create Food category (sets categoryId)') pm.environment.set('testCategoryName', 'Food-' + now.getTime());"
  ] } }],
  "item": [
    {
      "name": "Lab 1 - Public REST basics",
      "item": [
        { "name": "GET Hello", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/hello" } },
        { "name": "GET Hello by name", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/hello/Morris" } },
        { "name": "POST Hello message", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "text/plain" }], "body": { "mode": "raw", "raw": "Test message" }, "url": "{{baseUrl}}/api/hello" } }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        { "name": "Register new account", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{$randomFirstName}}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"FinancePass1!\"\n}" }, "url": "{{baseUrl}}/api/auth/register" } },
        { "name": "Login demo user (sets token)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Login succeeded', () => pm.response.to.have.status(200));", "pm.environment.set('token', pm.response.json().accessToken);" ] } }], "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" } },
        { "name": "Login admin (sets adminToken)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Admin login succeeded', () => pm.response.to.have.status(200));", "pm.environment.set('adminToken', pm.response.json().accessToken);" ] } }], "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" } },
        { "name": "Protected request without token (401)", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/categories" } }
      ]
    },
    {
      "name": "Categories",
      "item": [
        { "name": "List categories", "request": { "method": "GET", "url": "{{baseUrl}}/api/categories?page=0&size=20&sortBy=name&direction=asc" } },
        { "name": "Create Food category (sets categoryId)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Category created', () => pm.response.to.have.status(201));", "pm.environment.set('categoryId', pm.response.json().id);" ] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{testCategoryName}}\",\n  \"type\": \"EXPENSE\"\n}" }, "url": "{{baseUrl}}/api/categories" } },
        { "name": "Get category", "request": { "method": "GET", "url": "{{baseUrl}}/api/categories/{{categoryId}}" } },
        { "name": "Update category", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{testCategoryName}} and dining\",\n  \"type\": \"EXPENSE\"\n}" }, "url": "{{baseUrl}}/api/categories/{{categoryId}}" } }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        { "name": "Search transactions (filters + pagination)", "request": { "method": "GET", "url": "{{baseUrl}}/api/transactions?page=0&size=20&sortBy=transactionDate&direction=desc&from={{currentMonth}}-01&to={{today}}&type=EXPENSE&query=market" } },
        { "name": "Create expense (sets transactionId)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Transaction created', () => pm.response.to.have.status(201));", "pm.environment.set('transactionId', pm.response.json().id);" ] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"type\": \"EXPENSE\",\n  \"amount\": 42.50,\n  \"transactionDate\": \"{{today}}\",\n  \"description\": \"Weekly market\",\n  \"currency\": \"PLN\",\n  \"categoryId\": {{categoryId}}\n}" }, "url": "{{baseUrl}}/api/transactions" } },
        { "name": "Get transaction", "request": { "method": "GET", "url": "{{baseUrl}}/api/transactions/{{transactionId}}" } },
        { "name": "Update transaction", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"type\": \"EXPENSE\",\n  \"amount\": 48.00,\n  \"transactionDate\": \"{{today}}\",\n  \"description\": \"Weekly market and bakery\",\n  \"currency\": \"PLN\",\n  \"categoryId\": {{categoryId}}\n}" }, "url": "{{baseUrl}}/api/transactions/{{transactionId}}" } },
        { "name": "Soft-delete transaction", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/transactions/{{transactionId}}" } },
        { "name": "Try deleted transaction (404)", "request": { "method": "GET", "url": "{{baseUrl}}/api/transactions/{{transactionId}}" } }
      ]
    },
    {
      "name": "Budgets and reports",
      "item": [
        { "name": "List budgets", "request": { "method": "GET", "url": "{{baseUrl}}/api/budgets?page=0&size=20&sortBy=monthStart&direction=desc" } },
        { "name": "Create monthly budget (sets budgetId)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Budget created', () => pm.response.to.have.status(201));", "pm.environment.set('budgetId', pm.response.json().id);" ] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"month\": \"{{currentMonth}}\",\n  \"limitAmount\": 1500.00,\n  \"currency\": \"PLN\",\n  \"categoryId\": {{categoryId}}\n}" }, "url": "{{baseUrl}}/api/budgets" } },
        { "name": "Monthly report", "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/monthly?month={{currentMonth}}&currency=PLN" } },
        { "name": "Soft-delete budget", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/budgets/{{budgetId}}" } }
      ]
    },
    {
      "name": "ADMIN restore",
      "item": [
        { "name": "Soft-delete category", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/categories/{{categoryId}}" } },
        { "name": "Restore category", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "POST", "url": "{{baseUrl}}/api/admin/categories/{{categoryId}}/restore" } },
        { "name": "Restore transaction", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "POST", "url": "{{baseUrl}}/api/admin/transactions/{{transactionId}}/restore" } },
        { "name": "Restore budget", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] }, "method": "POST", "url": "{{baseUrl}}/api/admin/budgets/{{budgetId}}/restore" } }
      ]
    }
  ]
}
